# Copy to .env.local and fill in real values. Never commit .env.local.

# IDX Broker API — server-side only, used by API/serverless functions that
# proxy requests to https://api.idxbroker.com. Do NOT prefix with VITE_.
IDX_BROKER_ACCESS_KEY=

# ---------------------------------------------------------------------------
# /dashboard — the private analytics page (api/dashboard.ts)
# ---------------------------------------------------------------------------

# The only thing between the public and the site's traffic data. If unset,
# the dashboard API refuses every request (503) rather than serving openly.
# Use a different value in production from the one in .env.local.
DASHBOARD_PASSWORD=

# GA4 measurement ID (G-XXXXXXXXXX) of the site's web stream, from
# analytics.google.com → Admin → Data streams. The ONE public variable here:
# it is inlined into the bundle at build time to install the GA4 tag on every
# page (src/components/feature/Analytics.tsx), and the dashboard reads it to
# confirm the tag is live. Unset = no tag, nothing recorded.
VITE_GA4_MEASUREMENT_ID=

# Numeric property ID, from Admin → Property details. NOT the G- ID above.
GA4_PROPERTY_ID=

# Exactly as Search Console lists the property:
#   sc-domain:stefaniepollack.com        for a domain property
#   https://www.stefaniepollack.com/     for a URL-prefix one (trailing slash)
GSC_SITE_URL=

# Service account from console.cloud.google.com → IAM → Service Accounts, with
# the "Google Analytics Data API" and "Search Console API" enabled. Grant it
# Viewer on the GA4 property AND add it in Search Console → Settings → Users
# and permissions — skipping that is what produces a 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key from the service account JSON, in quotes, with the literal
# backslash-n line breaks left exactly as they appear in that file.
GOOGLE_PRIVATE_KEY=""
